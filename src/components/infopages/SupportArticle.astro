---
// The frame shared by every support guide: title, intro, the article, and links
// back to Support and to the other guides.
import { supportGuides } from "./supportGuides";

interface Props {
  title: string;
  intro: string;
  path: string;
}
const { title, intro, path } = Astro.props;
const others = supportGuides.filter((guide) => guide.href !== path);
---
<section>
  <div class="mx-auto w-full lg:px-24 max-w-7xl md:px-12 items-center px-8 py-24">
    <div class="relative mx-auto max-w-[40rem] pt-20 pb-12">
      <a href="/support" class="text-sm font-medium text-pink-500 hover:text-black">← Support</a>
      <h1 class="mt-4 text-4xl tracking-tight font-medium text-black md:text-5xl font-display">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-7 text-gray-500">{intro}</p>
    </div>
    <div class="mx-auto max-w-[40rem] prose-base prose text-gray-500 prose-h2:text-black prose-h2:font-medium prose-h2:text-2xl prose-strong:text-black prose-a:font-semibold prose-a:text-pink-500 hover:prose-a:text-black">
      <slot />
    </div>
    <div class="mx-auto max-w-[40rem] mt-16 border-t border-black/5 pt-10">
      <p class="text-sm font-medium text-black">More guides</p>
      <ul class="mt-4 space-y-3">
        {others.map((guide) => (
          <li>
            <a href={guide.href} class="font-medium text-pink-500 hover:text-black">{guide.title}</a>
            <p class="text-sm text-gray-500">{guide.summary}</p>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-sm text-gray-500">
        Still stuck? Write to <a href="mailto:support@beautymark.app" class="font-semibold text-pink-500 hover:text-black">support@beautymark.app</a> or ask on our <a href="https://discord.gg/beautymark" class="font-semibold text-pink-500 hover:text-black">Discord</a>. 💖
      </p>
    </div>
  </div>
</section>
